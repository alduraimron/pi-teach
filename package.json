{
  "name": "pi-teach",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A persistent learning library for Pi",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alduraimron/pi-teach.git"
  },
  "homepage": "https://github.com/alduraimron/pi-teach#readme",
  "bugs": "https://github.com/alduraimron/pi-teach/issues",
  "keywords": [
    "pi-package",
    "education"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extensions/teach/index.ts"
    ],
    "skills": [
      "./skills/teach"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "src",
    "web/dist",
    "README.md",
    "docs",
    "dist/server.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --config web/vite.config.ts && esbuild src/server/daemon.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "prepack": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typebox": "^1.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
