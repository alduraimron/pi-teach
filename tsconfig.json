{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "types": ["node", "vite/client"],
    "esModuleInterop": true, "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "extensions/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts"]
}
